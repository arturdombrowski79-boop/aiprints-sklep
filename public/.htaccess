# AiPrints.pl – Astro (static) na LH.pl
Options -Indexes
DirectoryIndex index.html
RewriteEngine On
# HTTPS i bez www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://aiprints.pl%{REQUEST_URI} [L,R=301]
# stare adresy (poprzednia strona) -> odpowiedniki w sklepie
RewriteRule ^images/ /fototapeta [L,R=301]
RewriteRule ^fototapety(-chorzow)?/?$ /fototapeta [L,R=301]
RewriteRule ^grawer(-laserowy)?(-chorzow)?/?$ /prezenty-z-grawerem [L,R=301]
RewriteRule ^druk-wielkoformatowy-chorzow/?$ /druk-wielkoformatowy [L,R=301]
RewriteRule ^[a-z0-9-]+-chorzow/?$ /sklep [L,R=301]
# /strona.html -> /strona
RewriteCond %{THE_REQUEST} \s(/[^.\s?]*?)([^/.\s?]+)\.html[\s?]
RewriteRule ^ %1%2 [L,R=301]
# /strona -> strona.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^/.]+)/?$ $1.html [L]
ErrorDocument 404 /404.html
<IfModule mod_headers.c>
  # pliki z hashem w nazwie (assets/) – na stałe; zdjęcia mogą być podmieniane – 30 dni
  <FilesMatch "\.(woff2|js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(jpg|jpeg|png|webp|svg|pdf)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=300"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=15552000"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "frame-ancestors 'self'; upgrade-insecure-requests; object-src 'none'; base-uri 'self'"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>
