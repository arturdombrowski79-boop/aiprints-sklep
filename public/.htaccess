# AiPrints.pl – Astro (static) na LH.pl
Options -Indexes
DirectoryIndex index.html
RewriteEngine On
# HTTPS i bez www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://aiprints.pl%{REQUEST_URI} [L,R=301]
# /strona.html -> /strona
RewriteCond %{THE_REQUEST} \s(/[^.\s?]*?)([^/.\s?]+)\.html[\s?]
RewriteRule ^ %1%2 [L,R=301]
# /strona -> strona.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^/.]+)/?$ $1.html [L]
ErrorDocument 404 /404.html
<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|jpeg|png|webp|svg|woff2|js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=300"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>
