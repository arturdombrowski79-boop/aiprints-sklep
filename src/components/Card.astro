---
import Ph from './Ph.astro';
const { p, c, big = false } = Astro.props;
const img = p.img || `img/ph/${p.cat}.svg`;
const alt2 = p.gallery && p.gallery.length > 1 ? p.gallery[p.gallery.length - 1] : null;
const zl = (v) => (Math.round(v * 100) / 100).toFixed(2).replace('.', ',').replace(',00', '') + ' zł';
const base = p.tiers ? p.tiers[0].p : p.price;
const od = p.tiers || /^od/.test(p.priceText || '') ? 'od ' : '';
const unitSuf = ((p.priceText || '').replace(/\s*\(.*\)$/, '').match(/\s*\/.*$/) || [''])[0];
const promoPrice = p.promo && base ? od + zl(base * p.promo.k) + unitSuf : null;
const price = p.price ? (/^od/.test(p.priceText) ? p.priceText : (p.tiers ? `od ${p.tiers[0].p} zł` : p.priceText.replace(/\s*\(.*\)$/, ''))) : 'Wycena';
---
<a href={`${p.slug}.html`} class="pc group block" data-sub={p.sub} data-price={p.price ?? 99999} data-score={p.score} data-i={p.img ? 1 : 0} data-quote={p.quote ? 1 : 0} data-t={p.tags ? Object.entries(p.tags).flatMap(([k, v]) => v.map((x) => k + ':' + x)).join(' ') : ''}>
  <div class={`relative overflow-hidden bg-paper2 rounded-[26px] ${big ? 'aspect-[4/5]' : 'aspect-square'}`}>
    {p.img ? <img src={img} alt={p.name} loading="lazy" width="760" height="760" class="w-full h-full object-cover transition duration-[900ms] ease-[cubic-bezier(.16,1,.3,1)] group-hover:scale-[1.05]" style={`view-transition-name:vt-${p.slug}`} /> : <Ph p={p} cls="transition duration-[900ms] group-hover:scale-[1.03]" />}
    {alt2 && <img src={alt2} alt="" loading="lazy" class="absolute inset-0 w-full h-full object-cover opacity-0 transition-opacity duration-700 group-hover:opacity-100" />}
    {p.promo && <span class="promo-on absolute right-3 top-3 rounded-full bg-[#c8102e] text-white px-2.5 py-1 text-[11.5px] font-semibold">−{p.promo.pct}%</span>}
    {p.quote && <span class="absolute left-3 top-3 rounded-full bg-white/90 backdrop-blur px-2.5 py-1 text-[11px] font-semibold">Wycena indywidualna</span>}
    <span class="absolute left-3 right-3 bottom-3 h-11 rounded-full bg-white/95 backdrop-blur text-[13.5px] font-semibold grid place-items-center opacity-0 translate-y-3 group-hover:opacity-100 group-hover:translate-y-0 transition duration-500 shadow-[0_10px_30px_rgba(0,0,0,.12)]">{p.quote || !p.price ? 'Zapytaj o wycenę →' : 'Personalizuj →'}</span>
  </div>
  <div class="pt-3.5 px-1 flex flex-col gap-1">
    <span class="min-w-0"><b class="block font-medium text-[15px] leading-snug">{p.name}</b><span class="block text-[12.5px] text-mute mt-0.5 truncate">{p.variants}</span></span>
    {promoPrice ? <>
      <b class="promo-on font-semibold text-[15px] whitespace-nowrap tabular text-[#c8102e]">{promoPrice}</b>
      <b class="promo-reg font-semibold text-[15px] whitespace-nowrap tabular">{price}</b>
      <span class="promo-on block text-[11.5px] leading-snug text-mute">Najniższa cena z 30 dni przed obniżką: {zl(p.promo.low30)}</span>
    </> : <b class="font-semibold text-[15px] whitespace-nowrap tabular">{price}</b>}
  </div>
</a>
