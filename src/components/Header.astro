---
import cat from '../data/catalog.json';
import { SEASON, BREAK } from '../data/config.js';
const { active = '' } = Astro.props;
const C = Object.fromEntries(cat.cats.map((c) => [c.slug, c]));
const cats = cat.cats.filter((c) => SEASON || c.slug !== 'na-swieta');
const thumb = (s) => (cat.products.find((p) => p.cat === s && p.img) || {}).img || `img/ph/${s}.svg`;
const PAGES = [
  { h: 'pliki/katalog-aiprints.pdf', n: 'Katalog PDF – pełna oferta i ceny', d: 'Do pobrania i wysłania mailem', k: 'katalog pdf oferta cennik ceny ulotka broszura do pobrania hurt' },
  { h: 'pliki/katalog-firmy-aiprints.pdf', n: 'Katalog dla firm PDF – ceny netto', d: 'Wspólnoty, szyldy, witryny, szkoły, salony', k: 'katalog pdf firmy b2b netto hurt wspolnoty zarzadcy oznakowanie oferta dla firm' },
  { h: 'uslugi.html#wspolpraca', n: 'Współpraca dla firm i hurt', d: 'Rabaty, faktura VAT, stałe zlecenia', k: 'wspolpraca hurt hurtowo b2b firmy agencje reseller rabat faktura' },
  { h: 'kontakt.html#wycena', n: 'Wycena i kontakt', d: 'Odpowiedź w dni robocze, firmy do 24 h', k: 'kontakt wycena zapytanie telefon email whatsapp adres mapa dojazd' },
  { h: 'realizacje.html', n: 'Realizacje', d: 'Prawdziwe zdjęcia z naszych zleceń', k: 'realizacje portfolio zdjecia prace przyklady galeria' },
  { h: 'uslugi.html', n: 'Usługi i maszyny', d: 'Wszystko, co robimy w pracowni', k: 'uslugi maszyny oferta druk grawer' },
  { h: 'pracownia.html', n: 'Pracownia w Chorzowie', d: 'ul. Okrężna 98B, pn–pt 9–17', k: 'pracownia o nas firma adres godziny okrezna chorzow' },
  { h: 'dostawa-i-platnosci.html', n: 'Dostawa i płatności', d: 'InPost, kurier, odbiór osobisty', k: 'dostawa wysylka platnosci paczkomat kurier odbior blik' },
  { h: 'zwroty-i-reklamacje.html', n: 'Zwroty i reklamacje', d: '', k: 'zwrot zwroty reklamacja reklamacje' },
  { h: 'regulamin.html', n: 'Regulamin sklepu', d: '', k: 'regulamin zasady' },
  { h: 'grawer-laserowy.html', n: 'Grawer i cięcie laserowe', d: 'CO₂ · MOPA · UV', k: 'grawer grawerowanie laser ciecie laserowe' },
  { h: 'druk-3d.html#kalkulator', n: 'Kalkulator druku 3D – cena od razu', d: 'Wgraj STL lub 3MF albo wybierz gotowy model', k: 'kalkulator kalkulatory druku druk 3d cena ceny koszt wycena wycenic policz ile kosztuje stl 3mf wydruk wydruki gotowe modele gotowce' },
  { h: 'druk-3d.html', n: 'Druk 3D na zamówienie', d: 'Od 1 sztuki, z Twojego pliku', k: 'druk 3d drukarka 3d prototyp czesci zamienne stl wydruki' },
  { h: 'fototapeta.html', n: 'Kalkulator fototapety – cena za m²', d: 'Wpisz wymiary ściany, cena od razu', k: 'kalkulator kalkulatory fototapeta fototapety tapeta cena wymiary m2 metr' },
  { h: 'druk-dla-artystow.html', n: 'Fine art i Digigraphie®', d: 'Edycje dla artystów i fotografów', k: 'fine art digigraphie artysta wydruk muzealny giclee' },
  { h: 'fotografia.html', n: 'Fotografia', d: 'Zdjęcia do dokumentów, sesje, dron', k: 'fotografia zdjecia do dokumentow sesja dron fotograf' },
  { h: 'druk-cyfrowy.html', n: 'Druk cyfrowy', d: 'Dyplomy, zaproszenia, broszury, wizytówki', k: 'druk cyfrowy wizytowki ulotki zaproszenia dyplomy broszury ksero kserowanie kopie skan skanowanie drukowanie prace dyplomowe magisterskie licencjackie' },
];
const nav = [['uslugi', 'Usługi'], ['druk-wielkoformatowy', 'Druk i reklama'], ['dla-firm', 'Dla firm']];
const cntF = (k, v) => cat.products.filter((p) => (SEASON || p.cat !== 'na-swieta') && p.tags[k].includes(v)).length;
const MEGA = [['okazja', 'Okazje', cat.facets.okazja], ['dla', 'Dla kogo', cat.facets.dla]];
---
<div id="brk" hidden class="bg-ye text-ink text-[13px] text-center px-4 py-2.5 font-medium" data-show={BREAK.show} data-to={BREAK.to}>Przerwa w pracy pracowni od 21 grudnia do 7 stycznia. Zamówienia złożone w tym czasie zaczniemy realizować od {BREAK.resume}.</div>
<script is:inline>(function(){var b=document.getElementById("brk"),n=new Date().toISOString().slice(0,10);if(n>=b.dataset.show&&n<=b.dataset.to)b.hidden=false;})()</script>
<div class="bg-ink text-white/90 text-[12.5px] text-center px-4 py-2.5 tracking-[.01em]">Projekt, który dla Ciebie przygotujemy, najpierw <b class="text-white">pokazujemy do akceptacji</b> – dopiero potem produkujemy</div>

<header id="hdr" class="sticky top-0 z-40 transition-[background,box-shadow] duration-300">
  <div class="max-w-[1360px] mx-auto px-5 md:px-10 h-[76px] flex items-center gap-8">
    <a href="index.html" aria-label="AiPrints.pl – strona główna" class="shrink-0"><img src="img/logo.svg" alt="AiPrints.pl" width="150" height="50" class="h-[42px] w-auto" /></a>
    <nav class="hidden xl:flex items-center gap-1 text-[14.5px]" aria-label="Główne menu">
      <div class="dd relative">
        <button class="h-10 px-3.5 rounded-full whitespace-nowrap hover:bg-black/[.04] flex items-center gap-1.5 font-medium" aria-expanded="false">Sklep <svg width="10" height="10" viewBox="0 0 10 10"><path d="M2 4l3 3 3-3" stroke="currentColor" fill="none" stroke-width="1.5"/></svg></button>
        <div class="ddm absolute left-0 top-full pt-3">
          <div class="w-[720px] rounded-[28px] bg-white border border-line shadow-[0_30px_80px_rgba(18,17,16,.14)] p-3 grid grid-cols-3 gap-1.5">
            {cats.map((c) => (
              <a href={`${c.slug}.html`} class="group flex items-center gap-3.5 rounded-2xl p-2.5 hover:bg-paper transition">
                <img src={thumb(c.slug)} alt="" class="w-14 h-14 rounded-xl object-cover bg-paper2" loading="lazy" />
                <span><b class="block text-[14.5px] font-semibold leading-tight">{c.name}</b><span class="text-[12.5px] text-mute">{c.count} produktów</span></span>
              </a>))}
            <a href="kontakt.html#wycena" class="col-span-3 mt-1 rounded-2xl bg-paper px-5 py-4 flex items-center justify-between text-[14px]"><span><b>Nie widzisz tego, czego szukasz?</b> <span class="text-mute">Zrobimy to na zamówienie.</span></span><span class="font-semibold">Zapytaj o wycenę →</span></a>
          </div>
        </div>
      </div>
      {MEGA.map(([k, t, gs]) => (
      <div class="dd relative">
        <button class="h-10 px-3.5 rounded-full whitespace-nowrap hover:bg-black/[.04] flex items-center gap-1.5 font-medium" aria-expanded="false">{t} <svg width="10" height="10" viewBox="0 0 10 10"><path d="M2 4l3 3 3-3" stroke="currentColor" fill="none" stroke-width="1.5"/></svg></button>
        <div class="ddm absolute left-0 top-full pt-3">
          <div class="w-[860px] rounded-[28px] bg-white border border-line shadow-[0_30px_80px_rgba(18,17,16,.14)] p-7 grid gap-6" style={`grid-template-columns:repeat(${gs.length},minmax(0,1fr))`}>
            {gs.map(([g, os]) => <div><p class="text-[11px] uppercase tracking-[.14em] text-mute mb-3">{g}</p>{os.filter(([v]) => cntF(k, v)).map(([v, n]) => <a href={`sklep.html?${k}=${v}`} class="block py-1.5 text-[14.5px] hover:text-acc transition">{n}</a>)}</div>)}
            <a href="sklep.html" class="col-span-full rounded-2xl bg-paper px-5 py-4 flex items-center justify-between text-[14px]"><span><b>Wszystkie prezenty</b> <span class="text-mute">– filtruj po okazji, osobie, materiale i cenie</span></span><span class="font-semibold">Przeglądaj →</span></a>
          </div>
        </div>
      </div>))}
      {nav.map(([h, t]) => <a href={`${h}.html`} class={`h-10 px-3.5 rounded-full grid place-items-center whitespace-nowrap hover:bg-black/[.04] transition ${active === h ? 'bg-black/[.05] font-semibold' : 'text-ink/80'}`}>{t}</a>)}
    </nav>
    <div class="ml-auto flex items-center gap-1.5">
      <button id="srchBtn" class="hidden md:flex items-center gap-3 h-11 w-[260px] rounded-full border border-line bg-white/70 px-4 text-[14px] text-mute hover:border-ink/30 transition" aria-label="Szukaj">
        <svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <span class="flex-1 text-left">Szukaj „kryształ”…</span><kbd class="text-[11px] border border-line rounded-md px-1.5 py-0.5 bg-white">/</kbd>
      </button>
      <button id="srchBtn2" class="md:hidden w-11 h-11 rounded-full hover:bg-black/5 grid place-items-center" aria-label="Szukaj"><svg width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg></button>
      <a href="konto.html" class="hidden sm:grid w-11 h-11 rounded-full hover:bg-black/5 place-items-center" aria-label="Moje konto"><svg width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"/></svg></a>
      <button id="cartBtn" class="relative w-11 h-11 rounded-full hover:bg-black/5 grid place-items-center" aria-label="Koszyk">
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M5 8h14l-1.2 11.2a2 2 0 0 1-2 1.8H8.2a2 2 0 0 1-2-1.8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
        <span id="cnt" class="absolute -top-0.5 -right-0.5 min-w-5 h-5 px-1 rounded-full bg-acc text-white text-[11px] font-bold grid place-items-center scale-0 transition-transform duration-300">0</span>
      </button>
      <button id="burger" class="xl:hidden w-11 h-11 rounded-full hover:bg-black/5 grid place-items-center" aria-label="Menu"><svg width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M4 8h16M4 16h16"/></svg></button>
    </div>
  </div>
</header>

<div id="mnav" class="scrim fixed inset-0 z-50 bg-paper overflow-auto">
  <div class="flex justify-between items-center px-5 h-[76px]"><img src="img/logo.svg" alt="AiPrints.pl" class="h-10 w-auto" /><button id="mclose" class="w-11 h-11 rounded-full hover:bg-black/5 text-[26px]" aria-label="Zamknij">×</button></div>
  <nav class="px-6 pb-10">
    <div class="grid grid-cols-2 gap-2 p-1 rounded-full bg-black/5" role="tablist">
      <button type="button" data-mt="s" class="mt h-11 rounded-full text-[15px] font-semibold bg-white shadow" aria-selected="true">Sklep</button>
      <button type="button" data-mt="u" class="mt h-11 rounded-full text-[15px] font-semibold" aria-selected="false">Usługi</button>
    </div>
    <div data-mp="s"><div class="grid gap-1 mt-4">
      {cats.map((c) => <a href={`${c.slug}.html`} class="hd text-[34px] py-1.5 border-b border-line">{c.name}</a>)}
    </div></div>
    <div data-mp="u" class="hidden"><div class="grid gap-2 mt-4">
      {[['druk-dla-artystow', 'Fine art – Digigraphie by Epson', 'Wydruki muzealne dla fotografów i artystów'], ['fototapeta', 'Fototapety na wymiar', 'Druk HP Latex, montaż na Śląsku'], ['druk-wielkoformatowy', 'Banery, folie, naklejki', 'Druk wielkoformatowy i cięcie po obrysie'], ['grawer-laserowy', 'Grawer i cięcie laserem', 'Szkło, drewno, metal, akryl'], ['druk-cyfrowy', 'Druk cyfrowy', 'Ulotki, broszury, dyplomy, kalendarze'], ['druk-3d', 'Druk 3D', 'Części, prototypy, figurki'], ['fotografia', 'Fotografia', 'Sesje, produkty, architektura'], ['dla-firm', 'Dla firm', 'Szyldy, gadżety, oznakowanie'], ['wspolnoty-i-spoldzielnie', 'Wspólnoty i spółdzielnie', 'Tablice i oznakowanie budynków'], ['szkoly-i-przedszkola', 'Szkoły i przedszkola', 'Grafiki, tabliczki, dyplomy'], ['uslugi', 'Wszystkie usługi i maszyny', 'Pełna lista tego, co robimy']].map(([h, t, d]) => <a href={`${h}.html`} class="rounded-2xl bg-white border border-line px-4 py-3"><b class="block text-[16px] font-semibold">{t}</b><span class="text-[13px] text-mute">{d}</span></a>)}
    </div></div>
    <div class="grid grid-cols-2 gap-2 mt-6">
      {[['sklep', 'Znajdź prezent'], ['pracownia', 'Pracownia'], ['kontakt', 'Kontakt'], ['dostawa-i-platnosci', 'Dostawa'], ['realizacje', 'Realizacje'], ['zwroty-i-reklamacje', 'Reklamacje']].map(([h, t]) => <a href={`${h}.html`} class="rounded-2xl bg-white border border-line px-4 py-3.5 text-[15px] font-medium">{t}</a>)}
    </div>
    <div class="grid grid-cols-2 gap-2 mt-3"><a href="tel:+48609040274" class="h-12 rounded-full bg-ink text-white font-semibold grid place-items-center">Zadzwoń</a><a href="https://wa.me/48609040274" class="h-12 rounded-full border border-ink font-semibold grid place-items-center">WhatsApp</a></div>
  </nav>
</div>

<script>
  document.querySelectorAll('#mnav .mt').forEach((b) => b.addEventListener('click', () => {
    document.querySelectorAll('#mnav .mt').forEach((x) => { const on = x === b; x.setAttribute('aria-selected', String(on)); x.classList.toggle('bg-white', on); x.classList.toggle('shadow', on); });
    document.querySelectorAll('#mnav [data-mp]').forEach((p) => p.classList.toggle('hidden', p.dataset.mp !== b.dataset.mt));
  }));
</script>

<div id="srch" class="scrim fixed inset-0 z-[55] bg-black/35 backdrop-blur-sm grid place-items-start justify-center pt-[12vh] px-4">
  <div class="w-full max-w-[660px] rounded-[28px] bg-white shadow-2xl overflow-hidden">
    <div class="flex items-center gap-3 px-6 border-b border-line"><svg width="20" height="20" fill="none" stroke="#5c6064" stroke-width="1.8" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg><input id="q" type="search" aria-label="Szukaj produktów" placeholder="Czego szukasz? np. kryształ, deska, numer domu" class="flex-1 py-5 text-[17px] outline-none" autocomplete="off" /><kbd class="text-[11px] text-mute border border-line rounded px-1.5 py-0.5">Esc</kbd></div>
    <div id="qres" class="max-h-[60vh] overflow-auto p-2"></div>
  </div>
</div>
<script id="spages" type="application/json" set:html={JSON.stringify(PAGES)}></script>
<style>
  .dd .ddm { opacity: 0; visibility: hidden; pointer-events: none; transform: translateY(6px); transition: opacity .2s, transform .25s, visibility 0s .25s; }
  .dd:hover .ddm, .dd.open .ddm { opacity: 1; visibility: visible; pointer-events: auto; transform: none; transition-delay: 0s; }
  #hdr.sc { background: rgba(242,243,243,.95); backdrop-filter: blur(18px) saturate(1.5); -webkit-backdrop-filter: blur(18px) saturate(1.5); box-shadow: 0 1px 0 var(--color-line); }
</style>
<script>
  const $ = (i) => document.getElementById(i);
  let idx = [], idxP = null;
  const loadIdx = () => idxP || (idxP = fetch('search-index.json').then((r) => r.json()).then((d) => { idx = d; render($('q').value); }).catch(() => { idxP = null; }));
  const pages = JSON.parse($('spages').textContent);
  const norm = (s) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/ł/g, 'l');
  const open = (el) => { el.classList.add('on'); document.body.style.overflow = 'hidden'; };
  const close = (el) => { el.classList.remove('on'); document.body.style.overflow = ''; };
  // menu rozwijane: klawiatura (Enter/Spacja otwiera, Esc zamyka), bez łapania Tabem ukrytych linków
  document.querySelectorAll('.dd').forEach((dd) => {
    const b = dd.querySelector('button');
    const set = (on) => { dd.classList.toggle('open', on); b.setAttribute('aria-expanded', String(on)); };
    b.addEventListener('click', () => set(!dd.classList.contains('open')));
    dd.addEventListener('keydown', (e) => { if (e.key === 'Escape') { set(false); b.focus(); } });
    dd.addEventListener('focusout', (e) => { if (!dd.contains(e.relatedTarget)) set(false); });
    dd.addEventListener('mouseleave', () => set(false));
  });
  const hdr = $('hdr'); const onS = () => hdr.classList.toggle('sc', scrollY > 10); addEventListener('scroll', onS, { passive: true }); onS();
  $('burger').onclick = () => open($('mnav')); $('mclose').onclick = () => close($('mnav'));
  const os = () => { open($('srch')); setTimeout(() => $('q').focus(), 50); render($('q').value); loadIdx(); };
  $('srchBtn').onclick = os; $('srchBtn2').onclick = os; window.openSearch = os;
  $('srch').onclick = (e) => { if (e.target === $('srch')) close($('srch')); };
  addEventListener('keydown', (e) => { if (e.key === 'Escape') close($('srch')); if ((e.key === '/' || (e.key === 'k' && (e.metaKey || e.ctrlKey))) && !/INPUT|TEXTAREA/.test(document.activeElement.tagName)) { e.preventDefault(); os(); } });
  function render(q) {
    const t = norm(q.trim()).split(/\s+/).filter(Boolean);
    const r = (t.length ? idx.filter((p) => t.every((w) => norm(p.n + ' ' + p.c + ' ' + p.s.replace(/-/g, ' ')).includes(w))) : idx).slice(0, 12);
    const pg = t.length ? pages.filter((p) => t.every((w) => norm(p.n + ' ' + p.k).includes(w))).slice(0, 4) : [];
    const ph = pg.map((p) => `<a href="${p.h}" class="flex items-center gap-4 rounded-2xl p-2.5 hover:bg-paper"><span class="w-14 h-14 rounded-xl bg-ink text-white grid place-items-center text-[20px]">→</span><span class="flex-1"><b class="block text-[15px] font-medium">${p.n}</b><span class="text-[12.5px] text-mute">${p.d || 'Strona'}</span></span></a>`).join('');
    $('qres').innerHTML = (r.length || pg.length) ? ph + r.map((p) => `<a href="${p.s}.html" class="flex items-center gap-4 rounded-2xl p-2.5 hover:bg-paper"><img src="${p.i}" alt="" class="w-14 h-14 rounded-xl object-cover bg-paper2"><span class="flex-1"><b class="block text-[15px] font-medium">${p.n}</b><span class="text-[12.5px] text-mute">${p.c}</span></span><span class="text-[13.5px] font-semibold whitespace-nowrap">${p.p}</span></a>`).join('') : `<p class="p-6 text-mute">Nie mamy tego w katalogu – <a class="underline" href="kontakt.html">napisz do nas</a>, zrobimy na zamówienie.</p>`;
  }
  $('q').oninput = (e) => render(e.target.value);
</script>
