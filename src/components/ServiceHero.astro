---
// Nagłówek stron usług: tytuł, opis, dwa przyciski, zdjęcie poglądowe.
const { eyebrow, title, lead, img, alt, cta = 'Zapytaj o termin', shop = null, shopLabel = 'Zobacz w sklepie' } = Astro.props;
---
<section class="max-w-[1360px] mx-auto px-5 md:px-10 pt-14 grid lg:grid-cols-[1.05fr_1fr] gap-12 items-center">
  <div>
    <p class="reveal text-[12px] tracking-[.22em] uppercase text-gold font-semibold">{eyebrow}</p>
    <h1 class="reveal hd text-[52px] md:text-[84px] mt-5" set:html={title} />
    <p class="reveal text-[18px] text-mute leading-relaxed mt-7 max-w-[600px]">{lead}</p>
    <div class="reveal flex flex-wrap gap-3 mt-9"><a href="#zapytanie" class="btn btn-ink">{cta} →</a>{shop && <a href={shop} class="btn btn-out">{shopLabel}</a>}<a href="tel:+48609040274" class="btn btn-out">609 040 274</a></div>
  </div>
  <figure class="reveal"><img src={img} alt={alt} class="w-full aspect-[4/3] object-cover rounded-[36px]" /><figcaption class="text-[12.5px] text-mute mt-2">Zdjęcie poglądowe</figcaption></figure>
</section>
