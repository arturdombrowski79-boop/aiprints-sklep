---
import cat from '../data/catalog.json';
import { SEASON, SOCIAL } from '../data/config.js';
---
<footer class="bg-night text-[#c9ced2] mt-36">
  <div class="max-w-[1360px] mx-auto px-5 md:px-10 pt-20 pb-10">
    <div class="flex flex-wrap items-end justify-between gap-8 pb-16 mb-16 border-b border-white/10">
      <h2 class="hd text-white text-[56px] md:text-[96px]">Masz pomysł?<br />Zrobimy go <em class="text-acc">u nas</em>.</h2>
      <div class="flex flex-wrap gap-3"><a href="kontakt.html#wycena" class="btn bg-white text-ink">Napisz do nas</a><a href="tel:+48609040274" class="btn border border-white/20 text-white">609 040 274</a></div>
    </div>
    <div class="grid md:grid-cols-[1.4fr_1fr_1fr_1.2fr] gap-12">
      <div>
        <img src="img/logo-white.svg" alt="AiPrints.pl" class="h-11 w-auto" />
        <p class="mt-5 text-[14px] leading-relaxed max-w-[320px]">Pracownia druku, graweru i druku 3D w Chorzowie. Każdy produkt robimy u siebie, na własnych maszynach, i przed produkcją pokazujemy projekt do akceptacji.</p>
        <p class="mt-6 text-[13px] text-[#9aa0a6]">BLIK · Visa · Mastercard · Apple Pay · Google Pay · Przelewy24</p>
      </div>
      <div>
        <b class="text-white text-[13px] tracking-[.14em] uppercase">Sklep</b>
        <ul class="mt-4 grid gap-2 text-[14px]">{cat.cats.filter((c) => SEASON || c.slug !== 'na-swieta').map((c) => <li><a class="hover:text-white" href={`${c.slug}.html`}>{c.name}</a></li>)}</ul>
      </div>
      <div>
        <b class="text-white text-[13px] tracking-[.14em] uppercase">Informacje</b>
        <ul class="mt-4 grid gap-2 text-[14px]">
          {[['uslugi', 'Usługi'], ['realizacje', 'Realizacje'], ['uslugi#do-pobrania', 'Katalog PDF'], ['uslugi#wspolpraca', 'Współpraca dla firm'], ['fotografia', 'Fotografia'], ['druk-cyfrowy', 'Druk cyfrowy'], ['druk-3d', 'Druk 3D'], ['grawer-laserowy', 'Grawer laserowy'], ['druk-dla-artystow', 'Fine art i Digigraphie'], ['pracownia', 'Pracownia'], ['dostawa-i-platnosci', 'Dostawa i płatności'], ['zwroty-i-reklamacje', 'Zwroty i reklamacje'], ['regulamin', 'Regulamin'], ['polityka-prywatnosci', 'Polityka prywatności'], ['kontakt', 'Kontakt']].map(([h, t]) => <li><a class="hover:text-white" href={h.includes('#') ? h.replace('#', '.html#') : `${h}.html`}>{t}</a></li>)}
        </ul>
      </div>
      <div>
        <b class="text-white text-[13px] tracking-[.14em] uppercase">Kontakt</b>
        <address class="not-italic mt-4 text-[14px] leading-relaxed">
          AiPrints.pl Artur Dombrowski<br />ul. Okrężna 98B, 41-500 Chorzów<br />
          <a class="hover:text-white" href="tel:+48609040274">+48 609 040 274</a><br />
          <a class="hover:text-white" href="mailto:kontakt@aiprints.pl">kontakt@aiprints.pl</a><br />
          <span class="text-[#9aa0a6]">NIP 626-257-96-94 · pn–pt 9:00–17:00</span>
        </address>
        <div class="flex gap-2.5 mt-4">
          {SOCIAL.facebook && <a href={SOCIAL.facebook} target="_blank" rel="noopener" aria-label="AiPrints.pl na Facebooku" class="w-10 h-10 rounded-full border border-white/20 grid place-items-center hover:bg-white hover:text-ink transition"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 21v-7.5h2.5l.4-3h-2.9V8.6c0-.9.3-1.5 1.5-1.5h1.5V4.4c-.3 0-1.2-.1-2.2-.1-2.2 0-3.7 1.3-3.7 3.8v2.4H8v3h2.6V21h2.9z"/></svg></a>}
          {SOCIAL.instagram && <a href={SOCIAL.instagram} target="_blank" rel="noopener" aria-label="AiPrints.pl na Instagramie" class="w-10 h-10 rounded-full border border-white/20 grid place-items-center hover:bg-white hover:text-ink transition"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg></a>}
          {SOCIAL.tiktok && <a href={SOCIAL.tiktok} target="_blank" rel="noopener" aria-label="AiPrints.pl na TikToku" class="w-10 h-10 rounded-full border border-white/20 grid place-items-center hover:bg-white hover:text-ink transition"><svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M16.5 3c.4 2.3 1.8 3.7 4 3.9v3.1c-1.5 0-2.9-.5-4-1.3v6.4c0 3.6-2.9 5.9-5.9 5.9S5 18.7 5 15.4c0-3.4 2.9-5.9 6.4-5.5v3.2c-1.6-.4-3.2.7-3.2 2.3 0 1.4 1.1 2.4 2.5 2.4 1.5 0 2.6-1 2.6-2.9V3h3.2z"/></svg></a>}
          {SOCIAL.youtube && <a href={SOCIAL.youtube} target="_blank" rel="noopener" aria-label="AiPrints.pl na YouTube" class="w-10 h-10 rounded-full border border-white/20 grid place-items-center hover:bg-white hover:text-ink transition"><svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor"><path d="M21.6 7.2c-.2-.9-.9-1.6-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4c-.9.2-1.6.9-1.8 1.8C2 8.8 2 12 2 12s0 3.2.4 4.8c.2.9.9 1.6 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4c.9-.2 1.6-.9 1.8-1.8.4-1.6.4-4.8.4-4.8s0-3.2-.4-4.8zM10 15V9l5.2 3L10 15z"/></svg></a>}
        </div>
      </div>
    </div>
    <div class="mt-16 pt-6 border-t border-white/10 flex flex-wrap gap-4 justify-between text-[12.5px] text-[#9aa0a6]">
      <span>© 2026 AiPrints.pl · Producent wszystkich wyrobów: AiPrints.pl Artur Dombrowski, ul. Okrężna 98B, 41-500 Chorzów</span>
      <button id="ckSet" class="underline hover:text-white">Ustawienia cookies</button>
    </div>
  </div>
</footer>
<div id="ck" role="dialog" aria-labelledby="ckT" aria-describedby="ckD" class="hidden fixed bottom-4 left-4 right-4 md:left-auto md:max-w-[440px] z-[80] rounded-3xl bg-white border border-line shadow-[0_24px_60px_-12px_rgba(17,18,20,.28)] p-6 text-[14px]">
  <b id="ckT" class="font-display text-[26px] leading-none">Pliki cookies</b>
  <p id="ckD" class="text-mute mt-2">Niezbędne pliki obsługują koszyk i logowanie. Za Twoją zgodą użyjemy też statystyk (Google Analytics) i reklam (Google Ads, Meta). Zgodę zmienisz w każdej chwili w stopce. <a href="polityka-prywatnosci.html" class="underline">Polityka prywatności</a></p>
  <div id="ckOpt" class="hidden mt-4 grid gap-2">
    <label class="flex items-start gap-3 rounded-2xl border border-line p-3.5 opacity-70"><input type="checkbox" checked disabled class="mt-0.5 w-[18px] h-[18px]"><span><b class="block">Niezbędne</b><span class="text-mute text-[13px]">koszyk, logowanie, bezpieczeństwo – zawsze włączone</span></span></label>
    <label class="flex items-start gap-3 rounded-2xl border border-line p-3.5 cursor-pointer"><input id="ckStat" type="checkbox" class="mt-0.5 w-[18px] h-[18px]"><span><b class="block">Statystyki</b><span class="text-mute text-[13px]">Google Analytics – które produkty są oglądane</span></span></label>
    <label class="flex items-start gap-3 rounded-2xl border border-line p-3.5 cursor-pointer"><input id="ckAds" type="checkbox" class="mt-0.5 w-[18px] h-[18px]"><span><b class="block">Marketing</b><span class="text-mute text-[13px]">Google Ads, Meta Pixel – dopasowane reklamy</span></span></label>
  </div>
  <div class="grid grid-cols-2 gap-2 mt-4">
    <button data-ck="none" class="h-11 rounded-full border border-ink font-semibold">Odrzuć</button>
    <button data-ck="all" class="h-11 rounded-full border border-ink font-semibold">Akceptuj wszystkie</button>
    <button id="ckMore" class="col-span-2 h-10 text-[13.5px] underline">Wybierz, na co się zgadzasz</button>
    <button data-ck="save" class="hidden col-span-2 h-11 rounded-full bg-ink text-white font-semibold">Zapisz wybór</button>
  </div>
</div>
<script>
  const ck = document.getElementById('ck');
  const get = () => { try { return JSON.parse(localStorage.getItem('aiprints-consent')); } catch (e) { return null; } };
  const save = (c) => { c.t = new Date().toISOString(); c.v = 1; try { localStorage.setItem('aiprints-consent', JSON.stringify(c)); } catch (e) { } window.applyConsent && window.applyConsent(c); ck.classList.add('hidden'); };
  if (!get()) ck.classList.remove('hidden');
  const more = (on) => { document.getElementById('ckOpt').classList.toggle('hidden', !on); ck.querySelector('[data-ck=save]').classList.toggle('hidden', !on); document.getElementById('ckMore').classList.toggle('hidden', on); };
  ck.querySelectorAll('[data-ck]').forEach((b) => b.onclick = () => { const k = b.dataset.ck; save(k === 'all' ? { stat: true, ads: true } : k === 'none' ? { stat: false, ads: false } : { stat: document.getElementById('ckStat').checked, ads: document.getElementById('ckAds').checked }); });
  document.getElementById('ckMore').onclick = () => more(true);
  document.getElementById('ckSet').onclick = () => { const c = get() || {}; document.getElementById('ckStat').checked = !!c.stat; document.getElementById('ckAds').checked = !!c.ads; more(true); ck.classList.remove('hidden'); ck.querySelector('input:not([disabled])').focus(); };
</script>
