---
import Base from '../layouts/Base.astro';
import cat from '../data/catalog.json';
// najniższa cena „od” liczona z produktów w sklepie (ceny brutto) – zawsze aktualna z katalogu
const from = (fn) => { const v = cat.products.filter((p) => p.price && !p.quote && p.cat !== 'na-swieta' && fn(p)).map((p) => (p.tiers ? p.tiers[0].p : p.price)); return v.length ? Math.min(...v) : null; };
const zl = (v) => (Math.round(v * 100) / 100).toFixed(2).replace('.', ',').replace(',00', '') + ' zł';
const inCat = (c) => (p) => p.cat === c || (p.also || []).includes(c);
const U = [
  ['Prezenty personalizowane', 'Grawer, zdjęcie, kryształy 3D, akryl, drewno – z podglądem projektu przed produkcją.', 'sklep.html', 'Laser xTool CO₂, MOPA i UV · druk UV GoArt', from((p) => p.kind === 'gift' && inCat('prezenty-z-grawerem')(p)), 'img/f/krysztal-para-sq.jpg'],
  ['Fotografia i sesje', 'Zdjęcia do dokumentów, portret, sesje rodzinne i plenerowe, produkty, architektura, dron.', 'fotografia.html', 'Studio w pracowni · plener · dron', null, 'img/hf/sesja-rodzinna-1.jpg'],
  ['Druk cyfrowy', 'Prace dyplomowe, zaproszenia, kartki, wizytówki, ulotki składane, broszury zszywane.', 'druk-cyfrowy.html', 'Xerox C75 z finiszerem · do SRA3', from((p) => /Xerox/.test(p.machine || '')), 'img/hf/druk-cyfrowy-1.jpg'],
  ['Druk wielkoformatowy i reklama', 'Banery, siatki, folie, fototapety, naklejki po obrysie, witryny, litery z plotera.', 'druk-wielkoformatowy.html', 'HP Latex 375 · ploter tnący Summa S3', from(inCat('druk-wielkoformatowy')), 'img/hf/baner-reklamowy-1.jpg'],
  ['Fine art i Digigraphie®', 'Wydruki muzealne, reprodukcje, limitowane edycje dla artystów i fotografów, odbitki.', 'druk-dla-artystow.html', 'Epson SureColor P9500 · SureLab D1000 · EIZO CG319X', from((p) => inCat('dla-fotografow')(p) && /fine-art|digigraphie|wydruk/.test(p.slug)), 'img/hf/druk-dla-artystow-1.jpg'],
  ['Druk 3D na zamówienie', 'Części, prototypy, figurki i gadżety z PLA, PET-G, ASA, ABS, PLA-CF i TPU.', 'druk-3d.html', 'Bambu Lab H2C, X1C, A2L, A1 mini', from(inCat('wydruki-3d')), 'img/hf/druk-3d-z-pliku-1.jpg'],
  ['Sublimacja', 'Koszulki sportowe, koce, ręczniki, kubki – pełny nadruk, który nie schodzi w praniu.', 'sublimacja.html', 'Epson SureColor F500 + prasa', from(inCat('sublimacja')), 'img/hf/koszulka-sportowa-sublimacja-1.jpg'],
  ['Szyldy i oznakowanie firm', 'Szyldy z plexi i lustra, logo na ścianę, tabliczki, stojaki QR, upominki z logo.', 'dla-firm.html', 'Laser · druk UV · ploter', from(inCat('dla-firm')), 'img/hf/szyld-okragly-logo-1.jpg'],
  ['Wspólnoty i zarządcy', 'Tablice przy wejściu, regulaminy, numeracja lokali, tabliczki na skrzynki – w jednym stylu.', 'wspolnoty-i-spoldzielnie.html', 'Druk UV · laser · montaż', from(inCat('wspolnoty-i-spoldzielnie')), 'img/hf/tablica-wejscie-zarzadca-1.jpg'],
  ['Szkoły i przedszkola', 'Grafika na drzwi i okna, banery na ogrodzenie, plakaty grup, tabliczki sal, dyplomy.', 'szkoly-i-przedszkola.html', 'HP Latex · Summa · Xerox · laser', from(inCat('szkoly-i-przedszkola')), 'img/hf/plakaty-grup-przedszkolnych-1.jpg'],
];
---
<Base title="Usługi pracowni – druk, grawer, fotografia, druk 3D | Chorzów" description="Usługi pracowni AiPrints.pl w Chorzowie: prezenty personalizowane, fotografia, druk cyfrowy i wielkoformatowy, fine art i Digigraphie, druk 3D, sublimacja, szyldy i oznakowanie. Ceny od, wycena w 24 h." canonical="uslugi" active="uslugi">
  <section class="max-w-[1360px] mx-auto px-5 md:px-10 pt-14">
    <p class="reveal text-[12px] tracking-[.22em] uppercase text-gold font-semibold">Pracownia w Chorzowie · ul. Okrężna 98B</p>
    <h1 class="reveal hd text-[52px] md:text-[88px] mt-5 max-w-[1000px]">Wszystko, co robimy <em class="text-gold">u siebie</em>.</h1>
    <p class="reveal text-[18px] text-mute leading-relaxed mt-7 max-w-[640px]">Grawer i druk UV, druk cyfrowy i wielkoformatowy, fine art, druk 3D, sublimacja i fotografia – na własnych maszynach, bez podwykonawców. Ceny „od” pochodzą wprost z naszego sklepu; większe zlecenia wyceniamy w 24 h.</p>
  </section>
  <section class="max-w-[1360px] mx-auto px-5 md:px-10 mt-16 grid md:grid-cols-2 lg:grid-cols-3 gap-4">
    {U.map(([t, d, href, m, f, img]) => (
      <a href={href} class="reveal group rounded-[30px] bg-white border border-line overflow-hidden flex flex-col hover:border-ink transition">
        <img src={img} alt={t} loading="lazy" class="aspect-[16/10] object-cover w-full" />
        <div class="p-6 flex-1 flex flex-col">
          <div class="flex justify-between items-baseline gap-3"><h2 class="font-display text-[27px] leading-tight">{t}</h2>{f !== null ? <span class="text-[13.5px] font-semibold whitespace-nowrap">od {zl(f)}</span> : <span class="text-[13.5px] text-mute whitespace-nowrap">wycena</span>}</div>
          <p class="text-mute text-[14.5px] leading-relaxed mt-2 flex-1">{d}</p>
          <p class="text-[12.5px] text-mute mt-4 border-t border-line pt-3">{m}</p>
        </div>
      </a>))}
  </section>
  <section class="max-w-[1360px] mx-auto px-5 md:px-10 mt-20 grid lg:grid-cols-[1fr_1fr] gap-4">
    <div class="reveal rounded-[30px] bg-ink text-white p-8"><h2 class="font-display text-[32px] leading-tight">Nie widzisz swojej usługi?</h2><p class="text-white/70 mt-3">Laser tnie i graweruje drewno, sklejkę, akryl, skórę, karton i metal; druk UV nadrukuje prawie wszystko płaskiego i obłego. Opisz, czego potrzebujesz – powiemy, czy i jak to zrobimy.</p><a href="kontakt.html#wycena" class="btn bg-white text-ink mt-6 inline-flex">Zapytaj o wycenę →</a></div>
    <div class="reveal rounded-[30px] bg-white border border-line p-8"><h2 class="font-display text-[32px] leading-tight">Projekty: AI, Adobe Stock i grafik</h2><p class="text-mute mt-3">Projekty przygotowujemy sami, korzystając otwarcie z narzędzi AI, licencjonowanych grafik i zdjęć Adobe Stock oraz gotowych cyfrowych aranżacji. Część zdjęć w sklepie to wizualizacje – pokazują, jak będzie wyglądał produkt; sam produkt zawsze powstaje fizycznie w naszej pracowni. <a href="pracownia.html#projekty" class="underline">Więcej o tym, jak pracujemy</a>.</p></div>
  </section>
</Base>
