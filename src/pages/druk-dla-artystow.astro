---
import { existsSync } from 'node:fs';
import Base from '../layouts/Base.astro';
import ServiceHero from '../components/ServiceHero.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Faq from '../components/Faq.astro';
import Card from '../components/Card.astro';
import cat from '../data/catalog.json';
// oficjalne logo programu – wgrać plik od Epson jako public/img/site/digigraphie.svg (albo .png); do tego czasu nazwa tekstem
const logo = ['svg', 'png'].map((e) => `img/site/digigraphie.${e}`).find((f) => existsSync(new URL(`../../public/${f}`, import.meta.url)));
const prods = ['digigraphie-edycja', 'fine-art-druk', 'fine-art-bawelna', 'fine-art-imprime', 'reprodukcja-obrazu', 'wydruk-probny', 'wydruk-w-ramie', 'wydruk-wystawowy', 'portfolio-box'].map((s) => cat.products.find((p) => p.slug === s)).filter(Boolean);
const steps = [
  ['Konsultacja', 'Rozmawiamy o pracy, nakładzie edycji, papierze i formacie. Możesz przyjść z oryginałem albo przysłać plik.'],
  ['Plik lub reprodukcja', 'Przyjmujemy pliki w pełnej rozdzielczości (TIFF, PSD, PDF). Obrazy i grafiki możemy zreprodukować w pracowni.'],
  ['Soft proof na EIZO', 'Kolor oceniamy na monitorze EIZO ColorEdge CG319X z kalibracją sprzętową i profilami papierów – widzisz na ekranie, jak praca wyjdzie na wybranym papierze.'],
  ['Wydruk próbny', 'Przed całą edycją drukujemy próbkę (np. A4 lub fragment 1:1) na docelowym papierze. Poprawiamy, aż zaakceptujesz.'],
  ['Edycja', 'Drukujemy na Epson SureColor P9500 (do 44 cali) pigmentowymi tuszami UltraChrome. Każdy egzemplarz sprawdzamy w świetle o standardowej temperaturze barwowej.'],
  ['Certyfikacja', 'Przy edycji Digigraphie®: numeracja i podpis artysty, tłoczona pieczęć oraz certyfikat autentyczności dla każdego egzemplarza.'],
];
// papiery: „na miejscu” – od Artura (27.11.2026); „na zamówienie” – wybór Artura: kilka certyfikowanych Digigraphie (lista digigraphie.com) + tanie mediaJET, dostępne u dostawcy
const eizo = [
  ['31,1″ 4K', 'rozdzielczość 4096×2160 – widać każdy detal i ziarno'],
  ['99% Adobe RGB', 'pełna przestrzeń barw druku fine art, 98% DCI-P3'],
  ['Samokalibracja', 'wbudowany czujnik pilnuje koloru bez udziału człowieka'],
  ['Soft proof', 'podgląd na profilu ICC wybranego papieru przed wydrukiem'],
];
const papersHere = [
  ['Hahnemühle Photo Rag Baryta', '315 g/m² · 100% bawełna, powierzchnia barytowa z połyskiem – głęboka czerń, klasyczny wygląd odbitki srebrowej. Certyfikowany do edycji Digigraphie®.'],
  ['ImPrime Premium MC230', '230 g/m² · matowy, gładki – plakaty, ilustracje, grafiki i wydruki próbne.'],
  ['ImPrime 260 Bright White', '260 g/m² · jasna biel, wyraźny kontrast – fotografia i wydruki wystawowe.'],
  ['Płótno ImPrime', 'do obrazów na krośnie i reprodukcji malarstwa.'],
  ['Epson (SureLab D1000L)', 'papiery fotograficzne Epson w rolce i arkusze Epson Archival Matte – odbitki i powiększenia.'],
];
const papersOrder = [
  ['Hahnemühle Photo Rag', '308 g/m² · 100% bawełna, gładki mat – klasyk do fotografii i grafiki. Digigraphie®'],
  ['Hahnemühle William Turner', '310 g/m² · 100% bawełna, faktura papieru akwarelowego – reprodukcje malarstwa. Digigraphie®'],
  ['Canson Infinity Rag Photographique', '310 g/m² · 100% bawełna, gładki mat. Digigraphie®'],
  ['Canson Infinity Arches BFK Rives', '310 g/m² · 100% bawełna, papier graficzny o miękkiej fakturze. Digigraphie®'],
  ['Epson Fine Art Cotton Textured Natural', '300 g/m² · 100% bawełna, delikatna faktura. Digigraphie®'],
  ['mediaJET Museum Natural Silk / White Smooth', '300 g/m² · tańsza alternatywa do wystaw i portfolio (bez certyfikatu Digigraphie).'],
];
const faq = [
  ['Czym Digigraphie różni się od zwykłego wydruku fine art?', 'Digigraphie® to program Epson dla limitowanych edycji: wydruk na certyfikowanej drukarce Epson, tuszami UltraChrome, na papierze z listy zatwierdzonych, numerowany i podpisany przez artystę, z tłoczoną pieczęcią i certyfikatem. Kolekcjoner dostaje potwierdzenie, że kupuje oryginalny egzemplarz z ograniczonej serii.'],
  ['Na jakich papierach drukujecie?', 'Na miejscu mamy Hahnemühle Photo Rag Baryta 315 g, ImPrime Premium MC230, ImPrime 260 Bright White i płótno ImPrime, a do odbitek na Epson SureLab D1000L papiery Epson w rolce i Epson Archival Matte. Na zamówienie sprowadzamy papiery certyfikowane Digigraphie (Hahnemühle Photo Rag i William Turner, Canson Infinity Rag Photographique i Arches BFK Rives, Epson Fine Art Cotton) oraz tańsze papiery mediaJET – czas i cenę podamy w wycenie. Do edycji Digigraphie używamy wyłącznie papierów zatwierdzonych w programie (np. Hahnemühle Photo Rag Baryta, którą mamy na miejscu). Pomożemy dobrać papier – możesz zamówić wydruk próbny.'],
  ['Czy zrobicie reprodukcję mojego obrazu?', 'Tak – reprodukujemy obrazy, rysunki i grafiki, a następnie drukujemy je w wybranym formacie. Wycenę podamy po obejrzeniu pracy (rozmiar, faktura, technika).'],
  ['Ile to trwa?', 'Wydruk próbny zwykle w 2–3 dni robocze, cała edycja po akceptacji próbki – zależnie od nakładu i formatu.'],
  ['Czy wystawiacie fakturę?', 'Tak, dla artystów, galerii i fotografów wystawiamy faktury VAT.'],
];
---
<Base title="Druk fine art Katowice, Chorzów – giclée" description="Wydruki fine art i limitowane edycje Digigraphie® by Epson: Epson SureColor P9500, papiery bawełniane, soft proof na EIZO ColorEdge CG319X, wydruk próbny, numeracja i certyfikat. Pracownia w Chorzowie." canonical="druk-dla-artystow" active="druk-dla-artystow">
  <ServiceHero eyebrow="Fine art · Digigraphie® by Epson" title={'Druk fine art <em class="text-gold">w edycji muzealnej</em>.'} lead="Drukujemy dla artystów, fotografów i galerii: reprodukcje, fine art na papierach bawełnianych i limitowane, certyfikowane edycje Digigraphie® by Epson. Kolor ustawiamy na skalibrowanym monitorze EIZO i zawsze zaczynamy od wydruku próbnego." img="img/hf/druk-dla-artystow-1.jpg" alt="Sprawdzanie wydruku fine art w pracowni" cta="Zapytaj o wydruk lub edycję" shop="dla-fotografow.html" shopLabel="Fine art w sklepie" />
  <section class="max-w-[1360px] mx-auto px-5 md:px-10 mt-28 grid lg:grid-cols-[1fr_1.2fr] gap-12 items-start">
    <div class="reveal rounded-[34px] bg-ink text-white p-8 md:p-10">
      {logo ? <img src={logo} alt="Digigraphie® by Epson" class="h-16 w-auto bg-white rounded-xl p-3" /> : <p class="font-display text-[40px] leading-none">Digigraphie<sup class="text-[18px]">®</sup> <span class="text-white/60">by Epson</span></p>}
      <p class="text-white/75 leading-relaxed mt-6">Digigraphie® to certyfikowany przez Epson standard limitowanych edycji. Każdy egzemplarz drukujemy na certyfikowanej drukarce Epson, tuszami UltraChrome, na papierze z listy zatwierdzonych. Artysta numeruje i podpisuje odbitkę, a ta dostaje tłoczoną pieczęć i certyfikat autentyczności.</p>
      <p class="text-white/75 leading-relaxed mt-4">Dla kolekcjonera to dowód, że kupuje egzemplarz z ograniczonej, kontrolowanej serii – a nie kolejną kopię.</p>
    </div>
    <div class="grid sm:grid-cols-2 gap-4">
      {[['Epson SureColor P9500', 'Drukarka wielkoformatowa do 44 cali (112 cm) z pigmentowymi tuszami UltraChrome – głęboka czerń, szeroki gamut i trwałość na dziesięciolecia.'], ['EIZO ColorEdge CG319X', '31-calowy monitor 4K z kalibracją sprzętową i wbudowanym czujnikiem – kolor na ekranie zgadza się z wydrukiem.'], ['Papiery muzealne', 'Na miejscu Hahnemühle Photo Rag Baryta, papiery i płótno ImPrime; na zamówienie papiery certyfikowane Digigraphie i tańsze mediaJET. Dobierzemy papier do techniki i charakteru pracy.'], ['Wydruk próbny', 'Zanim wydrukujemy edycję, akceptujesz próbkę na docelowym papierze.']].map(([t, d]) => (
        <div class="reveal rounded-[28px] bg-white border border-line p-6"><h3 class="font-display text-[24px] leading-tight">{t}</h3><p class="text-mute text-[14px] leading-relaxed mt-2">{d}</p></div>))}
    </div>
  </section>
  <section id="eizo" class="max-w-[1360px] mx-auto px-5 md:px-10 mt-28">
    <div class="reveal rounded-[34px] bg-ink text-white p-8 md:p-12 grid lg:grid-cols-[1.1fr_1fr] gap-10 items-center">
      <div>
        <p class="text-gold text-[13px] tracking-[0.14em] uppercase">Kolor pod kontrolą</p>
        <h2 class="font-display text-[40px] md:text-[56px] leading-[1.02] mt-3">Każdy wydruk zaczyna się na EIZO ColorEdge CG319X</h2>
        <p class="text-white/75 leading-relaxed mt-5">To monitor klasy referencyjnej, na jakim pracują studia postprodukcji i laboratoria fotograficzne. Kalibruje się sam wbudowanym czujnikiem, więc kolor na ekranie jest powtarzalny dzień po dniu. Z profilem wybranego papieru pokazuje, jak praca wyjdzie na wydruku, zanim uruchomimy drukarkę.</p>
        <p class="text-white/75 leading-relaxed mt-4">Chcesz zobaczyć swój plik na tym monitorze przed drukiem? Umów się na wizytę w pracowni w Chorzowie: <a class="underline underline-offset-4" href="tel:+48609040274">609 040 274</a>.</p>
      </div>
      <div class="grid grid-cols-2 gap-3">
        {eizo.map(([v, d]) => <div class="rounded-[24px] border border-white/15 p-5"><p class="font-display text-[22px] sm:text-[30px] md:text-[36px] leading-none">{v}</p><p class="text-white/65 text-[13.5px] leading-snug mt-2">{d}</p></div>)}
      </div>
    </div>
  </section>
  <section class="max-w-[1360px] mx-auto px-5 md:px-10 mt-28">
    <h2 class="reveal font-display text-[44px] md:text-[60px] leading-none">Jak pracujemy</h2>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4 mt-10">
      {steps.map(([t, d], i) => (<article class="reveal rounded-[30px] bg-white border border-line p-7"><span class="font-display text-[48px] leading-none text-gold/60">0{i + 1}</span><h3 class="font-display text-[26px] leading-tight mt-3">{t}</h3><p class="text-mute text-[14.5px] leading-relaxed mt-2">{d}</p></article>))}
    </div>
  </section>
  <section id="papiery" class="max-w-[1360px] mx-auto px-5 md:px-10 mt-28">
    <h2 class="reveal font-display text-[44px] md:text-[60px] leading-none">Papiery</h2>
    <p class="reveal text-mute max-w-[720px] leading-relaxed mt-4">Papiery z pierwszej listy mamy w pracowni. Pozostałe sprowadzamy na zamówienie – dostępny format, czas realizacji i cenę podamy w wycenie. Nie wiesz, który wybrać? Zamów wydruk próbny.</p>
    <div class="grid lg:grid-cols-2 gap-4 mt-10">
      <div class="reveal rounded-[30px] bg-white border border-line p-7"><h3 class="font-display text-[28px] leading-tight">Na miejscu</h3><ul class="mt-4 space-y-3">{papersHere.map(([t, d]) => <li class="text-[14.5px] leading-relaxed"><b class="font-semibold">{t}</b> <span class="text-mute">– {d}</span></li>)}</ul></div>
      <div class="reveal rounded-[30px] bg-white border border-line p-7"><h3 class="font-display text-[28px] leading-tight">Na zamówienie</h3><ul class="mt-4 space-y-3">{papersOrder.map(([t, d]) => <li class="text-[14.5px] leading-relaxed"><b class="font-semibold">{t}</b> <span class="text-mute">– {d}</span></li>)}</ul><p class="text-mute text-[13px] leading-relaxed mt-5">Digigraphie® – papier z listy zatwierdzonej przez Epson do certyfikowanych edycji. Część papierów jest dostępna tylko w wybranych formatach arkuszy lub rolek.</p></div>
    </div>
  </section>
  {prods.length > 0 && <section class="max-w-[1360px] mx-auto px-5 md:px-10 mt-28"><h2 class="reveal font-display text-[40px] md:text-[52px] leading-none">Zamów online</h2><div class="grid grid-cols-2 lg:grid-cols-4 gap-x-4 gap-y-10 mt-8">{prods.map((p) => <Card p={p} c={p.cat} />)}</div></section>}
  <section class="max-w-[960px] mx-auto px-5 md:px-10 mt-28"><QuoteForm about="Druk dla artystów / Digigraphie" title="Zapytaj o wydruk lub edycję" hint="Rodzaj pracy (fotografia, obraz, grafika), format, liczba egzemplarzy, czy edycja ma być certyfikowana Digigraphie, preferowany papier." accept="image/*,.tif,.tiff,.psd,.pdf,.zip" /></section>
  <Faq items={faq} />
</Base>
