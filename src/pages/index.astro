---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import Realizacje from '../components/Realizacje.astro';
import cat from '../data/catalog.json';
import { SEASON, PROMO, BREAK, SOCIAL } from '../data/config.js';
import { RECIPIENTS } from '../data/preview.js';
const P = cat.products;
// Shorts na stronie głównej – najnowszy NA GÓRZE: [id YouTube, tytuł, czas, data]. Okładka: img/site/pracownia/yt-<id>.jpg (miniatura z tools/yt-miniatury.js).
const SHORTS = [
  ['XVX_SyQnSk8', 'Nowości z grawera – wizytówki metalowe, kryształy, medale', 'PT27S', '2026-11-28'],
  ['TuYjdltZUFA', 'Fine art z Epson P9500 – druk pigmentowy giclée, Hahnemühle', 'PT36S', '2026-11-27'],
  ['i2XWFBcfqow', 'Druk 3D z Twojego pliku – odbierasz w paczkomacie', 'PT36S', '2026-11-26'],
  ['cUAksTQRdpo', 'Pracownia AiPrints.pl w Chorzowie – drukujemy, grawerujemy, personalizujemy', 'PT31S', '2026-11-26'],
  ['c_KYNIAt3MI', 'Pamięć, która zostaje – tabliczka na krzyż, zdjęcie na porcelanie', 'PT30S', '2026-11-25'],
  ['OpT0XGnzcKU', 'Prezent ze zdjęciem, który wzrusza – kryształ, akryl, grawer', 'PT27S', '2026-11-24'],
  ['zxVnsHK4kgw', 'Fototapeta na wymiar z Twojego zdjęcia – jak powstaje', 'PT33S', '2026-11-24'],
];
const by = (s) => P.find((p) => p.slug === s);
const best = ['krysztal-zdjecie', 'naszyjnik-grawer', 'deska-do-krojenia', 'karafka-grawer', 'numer-domu', 'mapa-nieba', 'niesmiertelnik', 'akryl-piosenka'].map(by).filter(Boolean);
const hp = by('krysztal-zdjecie'); const hpBase = hp.tiers ? hp.tiers[0].p : hp.price;
const zl0 = (v) => (Math.round(v * 100) / 100).toFixed(2).replace('.', ',').replace(',00', '') + ' zł';
const promo = P.filter((p) => p.promo && p.img).slice(0, 4);
const pUntil = new Date(PROMO.until).toLocaleDateString('pl-PL', { day: 'numeric', month: 'long' });
const cats = cat.cats.filter((c) => SEASON || c.slug !== 'na-swieta');
const tint = { 'druk-wielkoformatowy': '#e4ebf2', 'dla-fotografow': '#ecebe7', 'sublimacja': '#ece9f4', 'szkoly-i-przedszkola': '#e6f1ea', 'cmentarz-i-pogrzeb': '#ececec', 'prezenty-ze-zdjeciem': '#e9eef5', 'prezenty-z-grawerem': '#f1e7da', 'slub-i-okazje': '#f3e9ea', 'dla-firm': '#e7e7e4', 'wspolnoty-i-spoldzielnie': '#e3ece7', 'salony-beauty': '#f4e6ee', 'na-swieta': '#f2e4e1', 'sesje-i-zdjecia': '#efe9e2', 'wydruki-3d': '#e3eef0' };
const pick = { 'sesje-i-zdjecia': 'hf/sesja-rodzinna-1', 'wydruki-3d': 'hf/druk-3d-z-pliku-1', 'druk-wielkoformatowy': 'hf/baner-reklamowy-1', 'dla-fotografow': 'hf/fine-art-bawelna-1', 'sublimacja': 'hf/koszulka-sportowa-sublimacja-1', 'szkoly-i-przedszkola': 'hf/plakaty-grup-przedszkolnych-1', 'cmentarz-i-pogrzeb': 'hf/zdjecie-nagrobne-porcelana-1', 'prezenty-ze-zdjeciem': 'f/krysztal-para-sq', 'prezenty-z-grawerem': 'f/koperta-drewniana-sq', 'slub-i-okazje': 'hf/kieliszki-para-1', 'dla-firm': 'hf/termos-logo-sq', 'wspolnoty-i-spoldzielnie': 'hf/tablica-wejscie-zarzadca-sq', 'salony-beauty': 'hf/logo-lustro-1', 'na-swieta': 'bombka/glowne' };
const schema = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'Organization', name: 'AiPrints.pl', url: 'https://aiprints.pl/', sameAs: Object.values(SOCIAL).filter(Boolean), logo: 'https://aiprints.pl/img/logo.svg', telephone: '+48609040274', email: 'kontakt@aiprints.pl' },
  { '@type': 'LocalBusiness', '@id': 'https://aiprints.pl/#pracownia', url: 'https://aiprints.pl/', sameAs: Object.values(SOCIAL).filter(Boolean), name: 'AiPrints.pl', description: 'Pracownia druku i graweru w Chorzowie', geo: { '@type': 'GeoCoordinates', latitude: 50.319089, longitude: 18.949541 }, hasMap: 'https://www.google.com/maps/place/?q=place_id:ChIJxS3jtSfTFkcRKZ--r8yWHqA', areaServed: ['Chorzów', 'Katowice', 'Ruda Śląska', 'Świętochłowice', 'Siemianowice Śląskie', 'Bytom', 'Śląsk'], email: 'kontakt@aiprints.pl', image: 'https://aiprints.pl/img/site/pracownia.jpg', telephone: '+48609040274', address: { '@type': 'PostalAddress', streetAddress: 'ul. Okrężna 98B', postalCode: '41-500', addressLocality: 'Chorzów', addressCountry: 'PL' }, openingHours: 'Mo-Fr 09:00-17:00', specialOpeningHoursSpecification: [{ '@type': 'OpeningHoursSpecification', validFrom: BREAK.from, validThrough: BREAK.to, opens: '00:00', closes: '00:00' }], priceRange: '$$' },
  { '@type': 'WebSite', name: 'AiPrints.pl', url: 'https://aiprints.pl/' },
  ...SHORTS.map(([id, n, d, dt]) => ({ '@type': 'VideoObject', name: n, description: n + ' – pracownia AiPrints.pl w Chorzowie.', thumbnailUrl: `https://aiprints.pl/img/site/pracownia/yt-${id}.jpg`, uploadDate: `${dt}T12:00:00+01:00`, duration: d, embedUrl: `https://www.youtube-nocookie.com/embed/${id}`, contentUrl: `https://www.youtube.com/shorts/${id}` }))] };
const faq = [
  ['Czy zobaczę projekt przed produkcją?', 'Tak. Do 2 dni roboczych od zamówienia wysyłamy podgląd na e-mail. Produkcję zaczynamy dopiero po Twojej akceptacji, a poprawki przed akceptacją są bezpłatne.'],
  ['Ile trwa realizacja?', 'Zwykle 5–10 dni roboczych od akceptacji projektu, plus 1–2 dni dostawy. Dokładny termin potwierdzamy razem z podglądem. Jeśli potrzebujesz produktu na konkretną datę – napisz przed zamówieniem.'],
  ['Czy mogę zwrócić produkt?', 'Produkty personalizowane robimy według Twojego projektu, dlatego nie można ich zwrócić bez podania przyczyny. Jeśli coś jest niezgodne z zamówieniem albo uszkodzone, złóż reklamację – naprawimy to.'],
  ['Czy wystawiacie faktury VAT?', 'Tak, dla każdej firmy, wspólnoty i spółdzielni. NIP wpiszesz w kasie. Stałym klientom firmowym dajemy płatność przelewem z terminem.'],
  ['Czy mogę odebrać zamówienie osobiście?', 'Tak, w pracowni przy ul. Okrężnej 98B w Chorzowie, od poniedziałku do piątku w godz. 9:00–17:00.'],
];
const materials = [['Drewno bukowe', 'url(img/hf/deska-do-krojenia-1.jpg) 30% 60%/400%'], ['Szkło K9', 'linear-gradient(135deg,#e9f1f4,#b9cbd3 60%,#f7fbfc)'], ['Akryl lustrzany', 'linear-gradient(135deg,#f3e3b5,#c9a24f 45%,#fff1c7 55%,#a8843a)'], ['Stal nierdzewna', 'linear-gradient(135deg,#e6e7e8,#a9adb1 50%,#f1f2f3)'], ['Czarny akryl', 'linear-gradient(135deg,#2a2a2a,#050505 60%,#3a3a3a)'], ['Sklejka', 'linear-gradient(135deg,#e8cfa4,#d7b57d)'], ['Dibond', 'linear-gradient(135deg,#fafafa,#dcdcdc)'], ['Płótno', 'url(img/hf/obraz-plotno-1.jpg) 50% 50%/500%']];
---
<Base title="Prezenty personalizowane, grawer i druk – Chorzów | AiPrints.pl" description="Prezenty ze zdjęciem i grawerem, kryształy 3D, szyldy dla firm i oznakowanie dla wspólnot. Robimy w pracowni w Chorzowie, podgląd projektu przed produkcją, wysyłka w całej Polsce." schema={schema}>

  <!-- HERO -->
  <section class="relative overflow-hidden">
        <div class="relative max-w-[1360px] mx-auto px-5 md:px-10 pt-14 md:pt-20 pb-20 md:pb-28 grid lg:grid-cols-[1.02fr_1fr] gap-14 items-center">
      <div>
        <h1 class="hd text-[64px] sm:text-[88px] lg:text-[96px]"><span class="h-in block">Twój pomysł,</span><span class="h-in block">nasza <em class="text-acc">pracownia</em>.</span></h1>
        <p class="h-in text-[18.5px] text-ink/70 leading-relaxed mt-8 max-w-[520px]">Prezenty z grawerem i zdjęciem, druk cyfrowy i wielkoformatowy, fine art, druk 3D, pieczątki i fotografia. Wszystko robimy u siebie w Chorzowie – a zanim cokolwiek powstanie, pokazujemy Ci projekt.</p>
        <div class="h-in grid grid-cols-2 gap-3 mt-10 max-w-[560px]">
          <a href="sklep.html" class="group rounded-[22px] bg-ink text-white p-4 md:p-5 flex flex-col justify-between min-h-[118px]"><span class="text-[12px] text-white/60 font-semibold tracking-wide">SKLEP</span><b class="text-[17px] md:text-[19px] leading-tight font-semibold">Prezenty i produkty z personalizacją →</b></a>
          <a href="#uslugi" class="group rounded-[22px] bg-white border border-ink/15 p-4 md:p-5 flex flex-col justify-between min-h-[118px] hover:border-ink transition"><span class="text-[12px] text-mute font-semibold tracking-wide">USŁUGI PRACOWNI</span><b class="text-[17px] md:text-[19px] leading-tight font-semibold">Druk, fine art, grawer i oznakowanie ↓</b></a>
        </div>
        <div class="h-in flex flex-wrap gap-2 mt-4 max-w-[560px]">
          {[['druk-dla-artystow', 'Fine art Digigraphie'], ['fototapeta', 'Fototapety'], ['druk-wielkoformatowy', 'Banery i naklejki'], ['grawer-laserowy', 'Grawer laserowy'], ['druk-3d', 'Druk 3D'], ['dla-firm', 'Dla firm'], ['wspolnoty-i-spoldzielnie', 'Wspólnoty']].map(([h, n]) => <a href={`${h}.html`} class="h-9 px-3.5 rounded-full border border-line bg-white/70 text-[13px] font-medium inline-flex items-center hover:border-ink transition">{n}</a>)}
        </div>
        <div class="h-in flex flex-wrap items-center gap-x-6 gap-y-2 mt-10 text-[13.5px] text-ink/70">
          <span class="flex items-center gap-2"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>Podgląd przed produkcją</span>
          <span class="flex items-center gap-2"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 21V9l9-6 9 6v12"/><path d="M9 21v-6h6v6"/></svg>Własna pracownia w Chorzowie</span>
          <span class="flex items-center gap-2"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>Faktura VAT</span>
        </div>
      </div>

      <!-- hero: zdjęcie + próbna personalizacja -->
      <div id="stack" class="relative">
        <div class="card-s relative rounded-[34px] overflow-hidden shadow-[0_50px_100px_-30px_rgba(10,12,20,.55)]" style="aspect-ratio:1408/900">
          <img src="img/f/krysztal-para.jpg" alt="Kryształ 3D ze zdjęciem pary na podstawce LED" class="absolute inset-0 w-full h-full object-cover scale-[1.02]" />
          <div class="absolute inset-0 bg-gradient-to-b from-black/50 via-transparent to-transparent"></div>
          <div class="absolute left-6 top-6 text-white"><span class="text-[11px] tracking-[.22em] font-semibold text-white/70">GRAWER LASEROWY W SZKLE K9</span><b class="hd block text-[34px] md:text-[44px] mt-1">Kryształ 3D ze zdjęciem</b></div>
          <a href="krysztal-zdjecie.html" class="absolute right-5 bottom-6 h-11 px-5 rounded-full bg-white text-ink text-[13.5px] font-semibold flex items-center gap-2 hover:-translate-y-0.5 transition">{hp.promo ? <><span class="promo-on text-[#c8102e]">od {zl0(hpBase * hp.promo.k)}</span><s class="promo-on text-mute font-normal">{zl0(hpBase)}</s><span class="promo-reg">od {zl0(hpBase)}</span></> : <span>od {zl0(hpBase)}</span>} →</a>
        </div>
        <!-- spróbuj -->
        <div data-d="18" class="card-s relative sm:absolute sm:-left-10 lg:-left-20 sm:-bottom-36 mt-5 sm:mt-0 sm:w-[300px] rounded-[26px] bg-white p-3 shadow-[0_30px_70px_-20px_rgba(18,17,16,.35)]">
          <div class="relative rounded-[18px] overflow-hidden" style="aspect-ratio:1408/768;container-type:inline-size">
            <img src="img/f/koperta-drewniana.jpg" alt="Drewniana koperta na pieniądze z grawerem" class="absolute inset-0 w-full h-full object-cover" />
            <span id="heroName" class="absolute -translate-x-1/2 -translate-y-1/2 whitespace-nowrap leading-none" style="left:31%;top:52%;font-size:4.2cqw;color:#6e4420;mix-blend-mode:multiply;font-family:'Great Vibes',cursive;text-shadow:0 .1cqw 0 rgba(255,255,255,.35)">Ania</span>
          </div>
          <div class="flex items-center gap-2 mt-3 px-1">
            <input id="heroIn" maxlength="14" aria-label="Imię do podglądu na kopercie" placeholder="Wpisz imię…" class="flex-1 min-w-0 h-11 rounded-full border border-line px-4 text-[14px] outline-none focus:border-ink" />
            <a href="koperta-drewniana.html" class="h-11 px-4 rounded-full bg-ink text-white text-[13px] font-semibold grid place-items-center whitespace-nowrap">Zamów</a>
          </div>
          <p class="text-[12px] text-mute px-2 pt-2 pb-1"><b class="text-ink">Spróbuj:</b> imię pojawi się na kopercie – tak działa podgląd na żywo.</p>
        </div>
        <div data-d="26" class="card-s hidden lg:flex absolute right-2 -bottom-20 rounded-2xl bg-white shadow-[0_20px_50px_rgba(18,17,16,.16)] pl-3 pr-5 py-3 items-center gap-3">
          <span class="w-10 h-10 rounded-full bg-ink text-white grid place-items-center"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg></span>
          <span><b class="block text-[14px]">Najpierw podgląd</b><span class="text-[12px] text-mute">produkujemy po Twojej akceptacji</span></span>
        </div>
      </div>
    </div>
  </section>

  <!-- pasek dla osób z TikToka / Instagrama / YouTube → /bio -->
  <div class="max-w-[1360px] mx-auto px-5 md:px-10 mt-6">
    <a href="bio.html?utm_source=strona&utm_medium=pasek" class="flex items-center justify-between gap-4 rounded-2xl bg-ink text-white px-5 py-3.5 md:px-7 hover:opacity-90 transition">
      <span class="flex items-center gap-3 text-[15px]"><svg class="shrink-0" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.5 3c.4 2.3 1.8 3.7 4 3.9v3.1c-1.5 0-2.9-.5-4-1.3v6.4c0 3.6-2.9 5.9-5.9 5.9S5 18.7 5 15.4c0-3.4 2.9-5.9 6.4-5.5v3.2c-1.6-.4-3.2.7-3.2 2.3 0 1.4 1.1 2.4 2.5 2.4 1.5 0 2.6-1 2.6-2.9V3h3.2z"/></svg><span><b>Widziałeś nas na TikToku?</b> <span class="text-white/70">Wszystkie produkty z naszych filmów w jednym miejscu.</span></span></span>
      <span class="shrink-0 text-[14px] font-semibold whitespace-nowrap">Zobacz →</span>
    </a>
  </div>

  <!-- usługi pracowni -->
  <section id="uslugi" class="max-w-[1360px] mx-auto px-5 md:px-10 mt-6 md:mt-10 scroll-mt-24" aria-labelledby="uslH">
    <div class="flex flex-wrap justify-between items-end gap-4">
      <div><span class="text-[12.5px] font-semibold tracking-[.18em] text-mute">USŁUGI PRACOWNI W CHORZOWIE</span><h2 id="uslH" class="reveal hd text-[44px] md:text-[72px] mt-2">Drukujemy, grawerujemy, personalizujemy</h2></div>
      <a href="uslugi.html" class="reveal btn btn-out">Wszystkie usługi i maszyny →</a>
    </div>
    <div class="grid lg:grid-cols-[.78fr_2fr] gap-4 mt-8">
      <figure class="reveal relative rounded-[28px] overflow-hidden bg-ink aspect-[4/5] lg:aspect-auto lg:min-h-full order-2 lg:order-1">
        <video id="loopV" class="absolute inset-0 w-full h-full object-cover" muted loop playsinline preload="none" poster="img/site/pracownia/loop-poster.jpg" aria-label="Maszyny w pracowni AiPrints.pl: druk HP Latex, ploter tnący, druk UV, Epson fine art"><source src="video/pracownia-loop.mp4" type="video/mp4" /></video>
        <span class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent pointer-events-none"></span>
        <figcaption class="absolute left-5 right-5 bottom-5 text-white"><b class="font-display text-[26px] leading-tight block">Tak pracują nasze maszyny</b><span class="text-[13px] text-white/80">HP Latex · Summa · druk UV · Epson Digigraphie</span></figcaption>
      </figure>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 order-1 lg:order-2">
        {[['druk-dla-artystow', 'Fine art – Digigraphie by Epson', 'Muzealne wydruki dla fotografów i artystów', 'fine-art'], ['fototapeta', 'Fototapety na wymiar', 'Druk HP Latex, GREENGUARD Gold', 'wielkoformat'], ['druk-wielkoformatowy', 'Banery, folie, naklejki', 'Druk i cięcie po obrysie', 'naklejki'], ['grawer-laserowy', 'Grawer i cięcie laserem', 'Szkło, drewno, metal, akryl', 'laser'], ['uslugi', 'Druk UV na przedmiotach', 'Etui, gadżety, tabliczki', 'uv'], ['druk-cyfrowy', 'Druk cyfrowy', 'Ulotki, broszury, dyplomy, kalendarze', 'cyfrowy'], ['szkoly-i-przedszkola', 'Szkoły i przedszkola', 'Grafiki na ściany, okna i sale', 'szkoly'], ['wspolnoty-i-spoldzielnie', 'Firmy i wspólnoty', 'Szyldy, tablice, oznakowanie', 'plotter']].map(([h, t, d, im]) => (
          <a href={`${h}.html`} class="reveal group relative rounded-[22px] overflow-hidden aspect-[4/5] block">
            <img src={`img/site/pracownia/${im}.jpg`} alt={t} loading="lazy" class="absolute inset-0 w-full h-full object-cover group-hover:scale-[1.04] transition duration-700" />
            <span class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/15 to-transparent"></span>
            <span class="absolute left-3.5 right-3.5 bottom-3.5 text-white"><b class="block font-display text-[19px] md:text-[22px] leading-[1.1]">{t}</b><span class="block text-[12px] text-white/80 mt-1 leading-snug">{d}</span></span>
          </a>))}
      </div>
    </div>
    <div class="reveal mt-4 rounded-[22px] bg-white border border-line p-5 flex flex-wrap items-center justify-between gap-3"><p class="text-[15px]"><b>Masz zlecenie dla firmy, szkoły lub wspólnoty?</b> <span class="text-mute">Wycena w 24 h, projekt przed produkcją, faktura VAT.</span></p><div class="flex gap-2"><a href="kontakt.html#wycena" class="btn btn-ink">Poproś o wycenę</a><a href="tel:+48609040274" class="btn btn-out">609 040 274</a></div></div>
  </section>

  <!-- materiały -->
  <section class="border-y border-line bg-white" aria-label="Materiały, na których pracujemy">
    <ul class="max-w-[1360px] mx-auto px-5 md:px-10 flex flex-wrap justify-center gap-x-9 gap-y-4 py-7">
      {materials.map(([n, bg]) => <li class="inline-flex items-center gap-3 text-[15px] font-medium text-ink/80"><i class="w-9 h-9 rounded-full border border-black/10 shadow-inner" style={`background:${bg}`}></i>{n}</li>)}
    </ul>
  </section>

  <!-- kategorie -->
  <section class="max-w-[1360px] mx-auto px-5 md:px-10 mt-28">
    <div class="flex items-end justify-between gap-8 flex-wrap">
      <div><h2 class="hd text-[52px] md:text-[80px] reveal">Czego szukasz?</h2></div>
      <p class="reveal text-ink/65 max-w-[400px] text-[16px] leading-relaxed">Ułożyliśmy sklep według okazji, a nie maszyn. Wybierz, dla kogo albo na co – resztą zajmie się pracownia.</p>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 mt-12">
      {cats.map((c) => (
        <a href={`${c.slug}.html`} class="reveal lift group relative rounded-[30px] overflow-hidden p-7 min-h-[330px] flex flex-col justify-between" style={`background:${tint[c.slug]}`}>
          <div class="flex justify-between items-start relative z-10">
            <span class="text-[12.5px] font-semibold text-ink/75">{c.count} produktów</span>
            <span class="w-11 h-11 rounded-full bg-white grid place-items-center transition group-hover:bg-ink group-hover:text-white"><svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M7 17 17 7M8 7h9v9"/></svg></span>
          </div>
          <img src={`img/${pick[c.slug]}.jpg`} alt="" loading="lazy" class="absolute right-[-8%] bottom-[-12%] w-[50%] aspect-square object-cover rounded-[28px] rotate-[6deg] shadow-[0_30px_60px_-20px_rgba(0,0,0,.35)] transition duration-700 group-hover:rotate-[2deg] group-hover:scale-105" />
          <div class="relative z-10 max-w-[52%]"><b class="hd text-[36px] md:text-[40px] block">{c.name}</b><p class="text-[13.5px] text-ink/60 mt-3 leading-snug line-clamp-3">{c.lead}</p></div>
        </a>))}
    </div>
  </section>

