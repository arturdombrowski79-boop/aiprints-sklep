  <script>
    import gsap from 'gsap';
    gsap.from('.h-in', { y: 28, duration: 1.1, ease: 'expo.out', stagger: .08, delay: .1 });
    const cards = [...document.querySelectorAll('.card-s')];
    const rail = document.getElementById('rail'); document.querySelectorAll('[data-rail]').forEach((b) => b.onclick = () => rail.scrollBy({ left: +b.dataset.rail * rail.clientWidth * .8, behavior: 'smooth' }));
    const hi = document.getElementById('heroIn'), hn = document.getElementById('heroName'); hi.addEventListener('input', () => { hn.textContent = hi.value.trim() || 'Ania'; }); const demo = ['Ania', 'Tomek', 'Babcia Zosia', 'Kuba']; let di = 0; const iv = setInterval(() => { if (hi.value) return clearInterval(iv); di = (di + 1) % demo.length; hn.textContent = demo[di]; }, 2200); hi.addEventListener('focus', () => clearInterval(iv));
    gsap.from(cards, { y: 80, opacity: 0, duration: 1.3, ease: 'expo.out', stagger: .1, delay: .3 });
    const st = document.getElementById('stack');
    if (matchMedia('(pointer:fine)').matches) st.parentElement.addEventListener('mousemove', (e) => {
      const r = st.getBoundingClientRect(), x = (e.clientX - r.left) / r.width - .5, y = (e.clientY - r.top) / r.height - .5;
      cards.forEach((c) => { const d = +c.dataset.d || 0; gsap.to(c, { x: x * d, y: y * d, duration: 1.2, ease: 'power3.out' }); });
    });
  </script>
  <script>
    const lv = document.getElementById('loopV');
    if (lv) {
      const slow = (navigator.connection && navigator.connection.saveData) || matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!slow) new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { lv.preload = 'auto'; lv.play().catch(() => {}); } else lv.pause(); }), { threshold: 0.25 }).observe(lv);
    }
    document.querySelectorAll('.ytf').forEach((b) => b.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = 'https://www.youtube-nocookie.com/embed/' + b.dataset.yt + '?autoplay=1&playsinline=1&rel=0';
      f.title = b.getAttribute('aria-label'); f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen'; f.allowFullscreen = true;
      f.className = 'absolute inset-0 w-full h-full border-0';
      const w = document.createElement('div'); w.className = 'relative rounded-[22px] overflow-hidden aspect-[9/16] bg-black'; w.appendChild(f); b.replaceWith(w);
    }));
