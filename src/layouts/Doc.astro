---
import Base from './Base.astro';
const { title, description, canonical, lead = '' } = Astro.props;
---
<Base title={title} description={description} canonical={canonical}>
  <section class="max-w-[860px] mx-auto px-6 pt-14">
    <nav class="text-[13px] text-mute"><a href="index.html" class="hover:text-ink">Sklep</a><span class="mx-2">/</span>{title}</nav>
    <h1 class="hd text-[56px] md:text-[88px] mt-6">{title}</h1>
    {lead && <p class="text-[17px] text-mute mt-5 leading-relaxed">{lead}</p>}
    <div class="doc mt-10"><slot /></div>
  </section>
</Base>
<style is:global>
  .doc { font-size: 15.5px; line-height: 1.7; color: #3b3632; }
  .doc h2 { font-family: var(--font-display); font-size: 32px; line-height: 1.1; color: var(--color-ink); margin: 2.4rem 0 .8rem; }
  .doc h3 { font-weight: 600; font-size: 17px; color: var(--color-ink); margin: 1.6rem 0 .4rem; }
  .doc p { margin: .6rem 0; }
  .doc ol, .doc ul { padding-left: 1.4rem; margin: .5rem 0; }
  .doc ol { list-style: decimal; } .doc ul { list-style: disc; }
  .doc ol ol { list-style: lower-alpha; }
  .doc li { margin: .3rem 0; } .doc li p { margin: 0; }
  .doc a { text-decoration: underline; }
  .doc table { width: 100%; border-collapse: collapse; margin: 1rem 0; font-size: 14.5px; }
  .doc td, .doc th { border-bottom: 1px solid var(--color-line); padding: .7rem .5rem; text-align: left; vertical-align: top; }
</style>
